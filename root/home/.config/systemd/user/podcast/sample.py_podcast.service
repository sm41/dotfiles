[Unit]
Description = service unit of Scraping Program
Documentation = https://fedoraproject.org/wiki/Packaging:Systemd#EnvironmentFiles_and_support_for_/etc/sysconfig_files
# ${FOOBAR} は変数を 1 つの単語に展開し、$FOOBAR は空白の変数値を複数の単語に分割します
# unitname-Mon@env_arg.service

[Service]
Type = oneshot
WorkingDirectory = %h/repository/podcast
# Source - https://stackoverflow.com/a/53855973
# Posted by DGDD
# Retrieved 2026-08-15, License - CC BY-SA 4.0

Environment = "PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart   = %h/.local/bin/uv   run -m podcast  -dow
